<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Elementos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Nombre del usuario"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Aquamarine"
                HorizontalTextAlignment="Center"                
                />
            <Entry
                x:Name="correoEntry"
                Placeholder="correo@ejemplo"
                Keyboard="Email"
                MaxLength="80"
                />
            <Editor
                x:Name="comentarioEditor"
                Placeholder="Escribe tus comentarios"
                AutoSize="TextChanges"
                MaxLength="300"
                HeightRequest="120"
                />
            <Button
                Text="guardar"
                BackgroundColor="DarkBlue"
                TextColor="White"
                CornerRadius="10"
                Clicked="Button_Clicked"
                />
            <Image
                Source="dotnet_bot.png"
                Aspect="AspectFit"
                HeightRequest="120"
                />
            <HorizontalStackLayout Spacing="8">
                <CheckBox
                x:Name="CondicionesCheckbox"
                Color="Aquamarine" />
                <Label Text="Acepto las condiciones" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Switch
                x:Name="NotificacionSwitch"
                IsToggled="true"
                OnColor="AliceBlue"
                ThumbColor="Azure"
                Toggled="OnNotificationesToggled" HorizontalOptions="Start"
                />
            <Picker
                x:Name="cursoPicker"
                Title="Elige un curso">
                    <Picker.Items>
                        <x:String>DAM1</x:String>
                        <x:String>DAM2</x:String>
                    </Picker.Items>
            </Picker>
            <DatePicker
                x:Name="fechaDatePicker"
                Format="dd/MM/yyyy"
                MinimumDate="01/01/2000"
                MaximumDate="12/31/2020"
                DateSelected="DateSelected"
                />
            <Slider
                x:Name="volumeSlider"
                Minimum="0"
                Maximum="100"
                Value="50"
                MinimumTrackColor="Azure"
                ThumbColor="Black"
                ValueChanged="volumeSlider_ValueChanged"
                
                />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
