<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Login.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            
            
            <Label
                 Text="Iniciar sesion"
                 FontSize="24"
                 FontAttributes="Bold"
                 TextColor="Aqua"
                 HorizontalTextAlignment="Center"/>
            <Label
                  Text="Nombre"
                  FontSize="18"
                  TextColor="MediumPurple"
                  HorizontalTextAlignment="Center"/>
                      
            <Entry
                x:Name="Nombre"
                Keyboard="Text"/>
                
            <Label
               Text="Contraseña"
               FontSize="18"
               TextColor="MediumPurple"
               HorizontalTextAlignment="Center"/>
               
            <Entry 
                x:Name="contraseña"
                Keyboard="Password"/>
                
            <HorizontalStackLayout>
                <CheckBox
                     x:Name="Recuerdame"
                     Color="Aquamarine" />
                
                <Label
                      Text="recuerdame"
                      FontSize="18"
                      TextColor="MediumPurple"
                      HorizontalTextAlignment="Center"
                    />
            </HorizontalStackLayout>

            <Button 
                Text="guardar"
                BackgroundColor="DarkBlue"
                TextColor="White"
                CornerRadius="10"
                Clicked="Button_Clicked"
                />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
