<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Persistencia.Pages.Preferencia"
             Title="Preferencia">
    <VerticalStackLayout>
        <Label 
            Text="Preferencias" 
            HorizontalOptions="Center" 
            FontAttributes="Bold"
            FontSize="Large"/>
        <HorizontalStackLayout
            Spacing="10"
            HorizontalOptions="Center"
            Margin="10">
        <Label 
            x:Name="usuario"
            Text="Usuario: "
            VerticalOptions="Center"/>
        <Entry
            x:Name="userName"
            />
        </HorizontalStackLayout>
        <HorizontalStackLayout
            Spacing="10"
            HorizontalOptions="Center"
            Margin="10">
            <Label 
                x:Name="passwordLabel"
                Text="Contraseña: "
                VerticalOptions="Center"/>
            <Entry
                x:Name="password"
                IsPassword="True"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout
            HorizontalOptions="Center"
            Margin="10">
            <CheckBox
            x:Name="recordarCheckBox"/>
            <Label 
                x:Name="recordarLabel"
                Text="Recuerdame"
                VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Button
            x:Name="guardarButton"
            Clicked="guardarButton_Clicked"
            Text="Aceptar"
            HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>