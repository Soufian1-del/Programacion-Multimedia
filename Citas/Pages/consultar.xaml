<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Citas.Pages.consultar"
             Title="consultar">
    <VerticalStackLayout>
        <CollectionView x:Name="ListaCitas">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8" />
                            <ColumnDefinition Width="0.2" />
                        </Grid.ColumnDefinitions>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Especialidad}" FontAttributes="Bold" FontSize="Large"></Label>
                            <Label Text="{Binding doctor}" FontAttributes="Bold" FontSize="Large"></Label>
                            <Label Text="{Binding fecha,StringFormat='Solicitada el {0:dd/MM/yyyy/HH:mm}'}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                        <Label Text="{Binding dias}" />
                        <Label Text="DIAS DE ESPERA" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>