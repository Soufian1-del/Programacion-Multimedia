<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Layout.Pages.VerticalPage"
             Title="VerticalPage">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
        <Label 
            Text="Welcome to Vertical"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            x:Name="Boton1"
            Text="Boton 1"
            HorizontalOptions="Start"
            VerticalOptions="Center" />
        <Button
            x:Name="Boton2"
            Text="Boton 2"
            HorizontalOptions="End" />
        <Button
            x:Name="Boton3"
            Text="Boton 3"
            HorizontalOptions="Center" />
        <Button
            x:Name="Boton4"
            Text="Boton 4"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>