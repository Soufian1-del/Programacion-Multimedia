<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Layout.Pages.GridPage"
             Title="GridPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Text="UNO" Grid.Row="0" Grid.Column="0"  />
        <Button Text="DOS" Grid.Row="0" Grid.Column="1"  />
        <Button Text="TRES" Grid.Row="0" Grid.Column="2"  />
        <Button Text="CUATRO" Grid.Row="0" Grid.Column="3"  />
        <Button Text="CINCO" Grid.Row="1" Grid.Column="0" />
        <Button Text="dos y medio" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"  BackgroundColor="DarkRed"/>
        <!-- <Button Text="TRES" Grid.Row="1" Grid.Column="2"  VerticalOptions="Center" 
HorizontalOptions="Center" /> -->
        <Button Text="OCHO" Grid.Row="1" Grid.Column="3"  />
        <Button Text="" Grid.Row="1" Grid.Column="3"  />
        <Button Text="" Grid.Row="2" Grid.Column="0"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="2" Grid.Column="1" BackgroundColor="White" />
        <Button Text="" Grid.Row="2" Grid.Column="2"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="2" Grid.Column="0"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="3" Grid.Column="1"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="3" Grid.Column="2"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="3" Grid.Column="0"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="3" Grid.Column="3"  BackgroundColor="White"/>
        <Button Text="" Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" BackgroundColor="DarkRed"/>


    </Grid>
</ContentPage>