<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Collection.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <CollectionView x:Name="listaPaises" SelectionMode="Single" SelectionChanged="listaPaises_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".2*"/>
                                <ColumnDefinition Width=".8*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding bandera}" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label  Text="{Binding nombre}" FontAttributes="Bold" />
                                <Label  Text="{Binding capital}" FontAttributes="Italic" IsVisible="Hidden" x:Name="Capital"/>
                            </VerticalStackLayout>
                            
                            
                        </Grid> 
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
